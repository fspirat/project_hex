{
  "schemaVersion": 1,
  "id": "hexgen",
  "version": "${version}",
  "name": "FSHEX GENERATOR",
  "description": "Кнопка над инвентарём, открывающая FSHEX GENERATOR — генератор HEX-градиентов с палитрой цветов прямо в игре.",
  "authors": [
    "fspirat"
  ],
  "contact": {
    "homepage": "https://fspirat.ru/hex_generator/"
  },
  "license": "MIT",
  "icon": "assets/hexgen/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.fspirat.hexgen.HexGenClient"
    ]
  },
  "mixins": [
    "hexgen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}